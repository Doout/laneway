{
  "name": "@laneway/admin-console",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@10.14.0",
  "type": "module",
  "scripts": {
    "api:check": "pnpm api:lint && pnpm api:routes && pnpm api:generate && pnpm api:test && git diff --exit-code -- src/generated/management-v1",
    "api:generate": "openapi-ts --file openapi-ts.config.ts",
    "api:lint": "redocly lint management-v1",
    "api:routes": "node scripts/check-management-contract.mjs",
    "api:test": "vitest run scripts/management-contract.test.ts",
    "dev": "vite --mode demo",
    "build": "vite build",
    "build:live": "tsc -b && vite build --mode live",
    "build:demo": "tsc -b && vite build --mode demo",
    "lint": "eslint . --max-warnings 0 --ignore-pattern 'src/generated/management-v1/generated/**'",
    "preview": "vite preview",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "typecheck": "tsc -b --pretty false"
  },
  "dependencies": {
    "@fontsource-variable/manrope": "^5.3.0",
    "@hookform/resolvers": "^5.7.1",
    "@tanstack/react-query": "^5.101.4",
    "clsx": "^2.1.1",
    "lucide-react": "^1.31.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-hook-form": "^7.85.0",
    "react-router-dom": "^7.18.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@hey-api/openapi-ts": "0.99.0",
    "@redocly/cli": "2.46.1",
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "eslint": "^10.8.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jsdom": "^30.0.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.67.0",
    "vite": "^8.2.1",
    "vitest": "^4.1.10"
  }
}
