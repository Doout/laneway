# Pin a published release. Mutable tags such as latest are rejected.
LANEWAY_VERSION=0.1.0

# Production defaults are shown explicitly. TCP and UDP controller traffic use
# the same numeric port.
LANEWAY_BIND_ADDRESS=0.0.0.0
LANEWAY_CONTROLLER_PORT=8443
LANEWAY_RELAY_QUIC_PORT=4433
LANEWAY_RELAY_TCP_PORT=443
LANEWAY_CONTROLLER_SERVER_NAME=lane.example.com

# Immutable identities and initial network values. Generate IDs with
# `laneway id`; do not reuse them across roles or networks.
LANEWAY_NETWORK_ID=REPLACE_NETWORK_ID
LANEWAY_CONTROLLER_SERVICE_ID=REPLACE_CONTROLLER_SERVICE_ID
LANEWAY_RELAY_SERVICE_ID=REPLACE_RELAY_SERVICE_ID
LANEWAY_NETWORK_NAME=production
LANEWAY_IPV4_POOL=100.96.0.0/16
LANEWAY_RELAY_PUBLIC_ENDPOINT=lane.example.com:4433
