# Pin a signed release. The installer writes these settings automatically.
# For a manual install, use the output of verify-rust-release.sh --install.
LANEWAY_CONTROL_RUNTIME=rust
LANEWAY_VERSION=1.2.3
LANEWAY_RUST_VERSION=1.2.3
LANEWAY_RUST_IMAGE_SUFFIX=
LANEWAY_CONSOLE_REPOSITORY=ghcr.io/doout/laneway/console
LANEWAY_RELAY_REPOSITORY=ghcr.io/doout/laneway/relay
LANEWAY_EDGE_REPOSITORY=ghcr.io/doout/laneway/edge
LANEWAY_RUST_CONTROLLER_IMAGE_DIGEST=sha256:REPLACE_CONSOLE_DIGEST
LANEWAY_RUST_RELAY_IMAGE_DIGEST=sha256:REPLACE_RELAY_DIGEST
LANEWAY_ADMIN_IMAGE_DIGEST=sha256:REPLACE_EDGE_DIGEST
LANEWAY_RUST_CONNECTOR_IMAGE_DIGEST=sha256:REPLACE_EDGE_DIGEST
LANEWAY_RUST_EXIT_NODE_IMAGE_DIGEST=sha256:REPLACE_EDGE_DIGEST

# Production defaults are shown explicitly. TCP and UDP controller traffic use
# the same numeric port.
LANEWAY_BIND_ADDRESS=0.0.0.0
LANEWAY_CONTROLLER_PORT=8443
LANEWAY_RELAY_QUIC_PORT=4433
LANEWAY_RELAY_TCP_PORT=443
LANEWAY_EXIT_DIRECT_PORT=4434
LANEWAY_CONTROLLER_SERVER_NAME=lane.example.com

# Immutable identities and initial network values. Generate IDs with
# `laneway id`; do not reuse them across roles or networks.
LANEWAY_NETWORK_ID=REPLACE_NETWORK_ID
LANEWAY_CONTROLLER_SERVICE_ID=REPLACE_CONTROLLER_SERVICE_ID
LANEWAY_RELAY_SERVICE_ID=REPLACE_RELAY_SERVICE_ID
LANEWAY_NETWORK_NAME=production
LANEWAY_IPV4_POOL=100.96.0.0/16
LANEWAY_RELAY_PUBLIC_ENDPOINT=lane.example.com:4433

# Encrypt every database/configuration/credential recovery bundle to an age
# X25519 recipient whose private identity is held off-host.
LANEWAY_BACKUP_RECIPIENT=age1REPLACE_WITH_OFF_HOST_RECIPIENT
