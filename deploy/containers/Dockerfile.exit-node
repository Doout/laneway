# syntax=docker/dockerfile:1.9@sha256:fe40cf4e92cd0c467be2cfc30657a680ae2398318afd50b0c80585784c604f28
FROM --platform=$BUILDPLATFORM golang:1.26-alpine@sha256:ecb67f987aa1a57794c91d19ade7ae0209f2f0f5496aaef9e6ae85ddf92d02ab AS build
ARG VERSION=dev
ARG TARGETOS
ARG TARGETARCH
WORKDIR /src
COPY go/go.mod go/go.sum ./
RUN go mod download
COPY go/ ./
RUN CGO_ENABLED=0 GOOS=${TARGETOS} GOARCH=${TARGETARCH} go build -trimpath \
    -ldflags="-s -w -X github.com/Doout/laneway/go/internal/buildinfo.Version=${VERSION}" \
    -o /out/laneway ./cmd/laneway

FROM build AS go-healthcheck
RUN CGO_ENABLED=0 GOOS=${TARGETOS} GOARCH=${TARGETARCH} go build -trimpath \
    -ldflags="-s -w -X github.com/Doout/laneway/go/internal/buildinfo.Version=${VERSION}" \
    -o /out/laneway-healthcheck ./cmd/laneway-healthcheck

FROM rust:1.91-alpine@sha256:45c1c35cd364b8055e9e86f8ecd3e8c874b2dcb658d8a4f94b5d111aa0d651a2 AS rust-runtime
ARG VERSION=dev
RUN apk add --no-cache musl-dev
WORKDIR /src
COPY rust/ ./rust/
COPY api/ ./api/
RUN LANEWAY_PRODUCT_VERSION="${VERSION}" \
    cargo build --locked --release --manifest-path rust/Cargo.toml \
      -p lanewayd-rs --bin lanewayd-rs

FROM alpine:3.23@sha256:469c9ea410b9215eaee7976ba6c0639039b444be8e5d638f7abbada189971eb2 AS base
RUN apk add --no-cache \
      ca-certificates=20261020-r0 \
      iproute2-minimal=6.17.0-r0 \
      libcrypto3=3.5.9-r0 \
      libssl3=3.5.9-r0 \
      nftables=1.1.5-r2 \
      procps-ng=4.0.5-r0 \
      setpriv=2.41.6-r1 \
      tini=0.19.0-r3 \
    && addgroup -g 65532 laneway \
    && adduser -D -H -u 65532 -G laneway laneway \
    && install -d -o 65532 -g 65532 -m 0700 /var/lib/laneway /run/laneway
COPY --from=build /out/laneway /usr/local/bin/laneway
RUN apk add --no-cache --virtual .cap-tools libcap-setcap=2.78-r0 \
    && setcap cap_net_admin=ep /bin/setpriv \
    && apk del .cap-tools
USER 65532:65532

FROM base AS go-exit
COPY --from=go-healthcheck /out/laneway-healthcheck /usr/local/bin/laneway-healthcheck
ENTRYPOINT ["/bin/setpriv", "--inh-caps=+net_admin", "--ambient-caps=+net_admin", "--no-new-privs", "/sbin/tini", "--", "/usr/local/bin/laneway", "node", "run"]
CMD ["-config", "/etc/laneway/exit-node.toml"]

FROM base AS rust-exit
COPY --from=rust-runtime /src/rust/target/release/lanewayd-rs /usr/local/bin/lanewayd-rs
COPY --chmod=0755 deploy/containers/run-rust-exit /usr/local/bin/run-rust-exit
ENTRYPOINT ["/bin/setpriv", "--inh-caps=+net_admin", "--ambient-caps=+net_admin", "--no-new-privs", "/sbin/tini", "--", "/usr/local/bin/run-rust-exit"]
CMD ["-config", "/etc/laneway/exit-node.toml"]
