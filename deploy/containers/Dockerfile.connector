# syntax=docker/dockerfile:1.9@sha256:fe40cf4e92cd0c467be2cfc30657a680ae2398318afd50b0c80585784c604f28
FROM --platform=$BUILDPLATFORM golang:1.26-alpine@sha256:0178a641fbb4858c5f1b48e34bdaabe0350a330a1b1149aabd498d0699ff5fb2 AS build
ARG BINARY=laneway
ARG VERSION=dev
ARG TARGETOS
ARG TARGETARCH
WORKDIR /src
COPY go/go.mod go/go.sum ./
RUN go mod download
COPY go/ ./
RUN CGO_ENABLED=0 GOOS=${TARGETOS} GOARCH=${TARGETARCH} go build -trimpath \
    -ldflags="-s -w -X laneway.dev/laneway/internal/buildinfo.Version=${VERSION}" \
    -o /out/laneway ./cmd/${BINARY}
RUN CGO_ENABLED=0 GOOS=${TARGETOS} GOARCH=${TARGETARCH} go build -trimpath \
    -ldflags="-s -w -X laneway.dev/laneway/internal/buildinfo.Version=${VERSION}" \
    -o /out/laneway-healthcheck ./cmd/laneway-healthcheck
RUN mkdir -p /out/connector-state /out/connector-run && chown 65532:65532 /out/connector-state /out/connector-run

FROM scratch
COPY --from=build /etc/ssl/certs/ca-certificates.crt /etc/ssl/certs/ca-certificates.crt
COPY --from=build /out/laneway /usr/local/bin/laneway
COPY --from=build /out/laneway-healthcheck /usr/local/bin/laneway-healthcheck
COPY --from=build --chown=65532:65532 /out/connector-state /var/lib/laneway
COPY --from=build --chown=65532:65532 /out/connector-run /run/laneway
HEALTHCHECK --interval=10s --timeout=3s --start-period=15s --retries=6 \
    CMD ["/usr/local/bin/laneway-healthcheck", "-unix", "/run/laneway/lanewayd.sock"]
USER 65532:65532
ENTRYPOINT ["/usr/local/bin/laneway"]
CMD ["connector", "run"]
