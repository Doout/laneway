# syntax=docker/dockerfile:1.9
FROM rust:1.88-alpine AS build
RUN apk add --no-cache musl-dev
WORKDIR /src
COPY rust/ ./rust/
COPY api/ ./api/
RUN cargo build --locked --release --manifest-path rust/Cargo.toml -p laneway-relay

FROM scratch
COPY --from=build /src/rust/target/release/laneway-relay /usr/local/bin/laneway-relay
USER 65532:65532
ENTRYPOINT ["/usr/local/bin/laneway-relay"]
